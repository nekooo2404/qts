# Copy these values into the local environment used by docker compose.
KEYCLOAK_DB_NAME=qts_keycloak
KEYCLOAK_DB_USER=qts_keycloak
KEYCLOAK_DB_PASSWORD=change-this-local-password
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-this-local-password
KEYCLOAK_PORT=8080

PLATFORM_DB_NAME=qts_identity
PLATFORM_DB_USER=qts_identity
PLATFORM_DB_PASSWORD=change-this-local-password
PLATFORM_APP_DB_USER=qts_identity_app
PLATFORM_APP_DB_PASSWORD=change-this-app-password
PLATFORM_DB_PORT=5433
IDENTITY_DATABASE_URL=postgresql://qts_identity_app:change-this-app-password@localhost:5433/qts_identity

REDIS_PASSWORD=change-this-local-password
REDIS_URL=redis://:change-this-local-password@localhost:6379

KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-local-password

KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/qts-identity
KEYCLOAK_ADMIN_URL=http://localhost:8080
KEYCLOAK_CLIENT_ID=qts-admin-console
KEYCLOAK_AUDIENCE=qts-admin-console
KEYCLOAK_CLIENT_SECRET=
IDENTITY_CALLBACK_URL=http://127.0.0.1:3100/api/identity/auth/callback
IDENTITY_SESSION_SECRET=development-only-identity-session-secret-change-me
IDENTITY_DEV_SESSION_BRIDGE=false
IDENTITY_METRICS_TOKEN=replace-with-a-random-metrics-token
