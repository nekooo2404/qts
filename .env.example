# Local demo database. PostgreSQL migration steps are documented in README.md.
DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3000"
SESSION_COOKIE_NAME="qts_session"
SESSION_TTL_DAYS="7"
SEED_DEMO="true"

# Use a stable key across production instances when Server Actions capture closures.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="replace-with-a-32-byte-base64-key"
